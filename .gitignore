# Виртуальное окружение
.venv/
venv/
ENV/
__pycache__/
*.pyc

# КРИТИЧНО: Исключить сессионные данные браузера и токены
user_data/
cs_profile/
*.session
.env

# Логи и временные файлы ОС
*.log
Thumbs.db
.DS_Store

# Скриншоты и бинарные дампы
*.png
output/*.png

# Опционально: исключить папку с фото, если они весят много
data/photos/

# Runtime-артефакты (генерируются при работе, содержат личные данные и кэш):
# БД, очереди, логи автопилота, кэш пола, результаты сбора хостов, отладочные дампы
output/
!output/.gitkeep
.aider*
